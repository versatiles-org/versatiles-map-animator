{
	"name": "versatiles-map-animator",
	"version": "0.2.0",
	"description": "Tool for composing map camera animations on a timeline (VersaTiles).",
	"private": true,
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/versatiles-org/versatiles-map-animator.git"
	},
	"license": "MIT",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "svelte-kit sync && vite build",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check": "npm run format && npm run check:svelte && npm run lint && npm run test",
		"doc-graph": "svelte-kit sync && vrt deps-graph | vrt doc-insert README.md '## Dependency Graph' && prettier --write --log-level warn README.md",
		"dev": "vite dev",
		"docker:build": "docker build -f render/Dockerfile -t versatiles-map-animator .",
		"docker:build:gpu": "docker build -f render/Dockerfile --build-arg GPU=true -t versatiles-map-animator:gpu .",
		"docker:build:server": "docker build -f render/Dockerfile --target server -t versatiles-map-animator:server .",
		"format:check": "prettier --log-level=warn --check .",
		"format": "prettier --log-level=warn --write .",
		"inspect": "tsx scripts/inspect-hash.ts",
		"lint": "eslint .",
		"prepack": "npm run build",
		"preview": "vite preview",
		"release": "vrt release-npm",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install --with-deps chromium",
		"test": "vitest run",
		"upgrade": "vrt deps-upgrade && cd render && vrt deps-upgrade"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"@versatiles/release-tool": "^2.21.0",
		"@versatiles/style": "^9.1.0",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"maplibre-gl": "^6.17.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.7",
		"vitest": "^5.1.0"
	},
	"allowScripts": {
		"esbuild": true,
		"fsevents": true
	}
}
